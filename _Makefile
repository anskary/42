NAME = libft.a

CC = gcc
CFLAGS = -Wall -Wextra -Werror

# files
OBJFILES = ./obj/
SRC = $(wildcard *.c)
OBJ = $(SRC:%.c=$(OBJFILES)%.o)

OBJDIR = $(OBJFILES)




# commands
all: $(NAME)

$(NAME): $(OBJ)
	@mkdir -p $(OBJFILES)
	ar -rc $(NAME) $(OBJ)


$(OBJFILES)%.o: $(SRC)%.c
	@$(CC) $(CFLAGS) -c -o $@ $<

	
clean:
	rm -f $(OBJ)

fclean: clean
	rm -f $(NAME)

re: fclean all


.PHONY: all clean fclean re
